;;; td-khoi-tao.lsp - Nap nhanh layer + text style TRAC DOC vao ban ve moi (ten chuan TK_268_ tu 2026-11-25)
;;; Cach dung: (load "D:/01. JOB/01. Mr. Tuan/Other/Training/Claude/.claude/skills/trac-doc/td-khoi-tao.lsp") roi go lenh TDKT
;;; Chi TAO phan con thieu; khong sua/ xoa layer, style da co. Mau ACI, linetype Continuous, lineweight mac dinh.
;;; Font (deu la font unicode co san): TK_268_ChuBang = arial.ttf (wf 0.8); TK_268_ChuKyHieu = arial.ttf;
;;; TK_268_TieuDe = arial.ttf; TK_268_ChuManh = calibril.ttf (Calibri Light, chu mong ghi chu cong dung).
(defun td:khoi-tao (/ n m)
  (setq n 0 m 0)
  (foreach d '(
    ("TK_268_DiemChiaDoan" 3)
    ("TK_268_TimTuyen" 1)
    ("TK_268_DuongTKTimTuyen" 1)
    ("TK_268_CocLyTrinh" 3)
    ("TK_268_CocH" 3)
    ("TK_268_CocKm" 3)
    ("TK_268_CocCamCong" 3)
    ("TK_268_DiemDo" 8)
    ("TK_268_ChuTracDoc" 3)
    ("TK_268_ThuocTL" 3)
    ("TK_268_LyTrinh" 3)
    ("TK_268_DuongDong" 8)
    ("TK_268_TracDocTuNhien" 3)
    ("TK_268_BangTracDoc" 3)
    ("TK_268_ChinhCao" 2)
    ("TK_268_ThongSoCong" 2)
    ("TK_268_GhiChuDauCong" 2)
    ("TK_268_GhiChuCucTri" 2)
    ("TK_268_GhiChuGiuaCong" 2)
    ("TK_268_TextHeader" 4)
  )
    (if (not (tblsearch "LAYER" (car d)))
      (progn (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
                     (cons 2 (car d)) '(70 . 0) (cons 62 (cadr d)) '(6 . "Continuous") '(370 . -3)))
             (setq n (1+ n)))))
  (foreach s '(
    ("TK_268_ChuKyHieu" 0.000 1.000 0.000 "arial.ttf")
    ("TK_268_TieuDe" 0.000 1.000 0.000 "arial.ttf")
    ("TK_268_ChuBang" 0.000 0.800 0.000 "arial.ttf")
    ("TK_268_ChuManh" 0.000 1.000 0.000 "calibril.ttf")
  )
    (if (not (tblsearch "STYLE" (car s)))
      (progn (entmake (list '(0 . "STYLE") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbTextStyleTableRecord")
                     (cons 2 (car s)) '(70 . 0) (cons 40 (cadr s)) (cons 41 (caddr s)) (cons 50 (cadddr s))
                     '(71 . 0) '(42 . 2.5) (cons 3 (nth 4 s)) '(4 . "")))
             (setq m (1+ m)))))
  (princ (strcat "
[TRAC DOC] Da tao " (itoa n) " layer, " (itoa m) " text style (phan da co giu nguyen). CHUA luu."))
  (princ))
(defun c:TDKT () (td:khoi-tao))
(princ "
[TRAC DOC] Go TDKT de nap layer/ text style trac doc (TK_268_).")
(princ)
